# URL publique utilisée pour les métadonnées, le sitemap et les liens absolus.
NEXT_PUBLIC_SITE_URL=https://votre-domaine.fr

# Webhook HTTPS durable recevant les inscriptions JSON.
MAILA_SIGNUP_WEBHOOK_URL=https://votre-service-email.fr/api/inscriptions

# Jeton facultatif envoyé dans l'en-tête Authorization: Bearer.
MAILA_SIGNUP_WEBHOOK_TOKEN=

# Développement local uniquement. La valeur par défaut est .data/subscribers.ndjson.
MAILA_SUBSCRIBERS_FILE=
